#!/usr/bin/env bash
# Build a host dist, then run it or pack it.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"

compose() {
  if command -v podman-compose >/dev/null 2>&1; then
    podman-compose -f compose.yaml "$@"
  elif command -v podman >/dev/null 2>&1 && podman compose version >/dev/null 2>&1; then
    podman compose -f compose.yaml "$@"
  elif command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    docker compose -f compose.yaml "$@"
  else
    echo "error: need podman-compose, podman compose, or docker compose" >&2
    exit 1
  fi
}

rebuild() {
  rm -rf "$DIR/dist"
  mkdir -p "$DIR/dist"
  : >"$DIR/dist/.gitkeep"
  compose up --build --force-recreate --abort-on-container-exit
}

package() {
  mkdir -p "$DIR/package"
  : >"$DIR/package/.gitkeep"
  version="$(awk -F'"' '/^version:/{print $2; exit}' "$DIR/dist/config/default.yaml")"
  version="${version:-0.0.0}"
  staging="$(mktemp -d)"
  mkdir -p "$staging/matchora"
  cp -a "$DIR/dist"/. "$staging/matchora/"
  rm -f "$staging/matchora/.gitkeep"
  tar -C "$staging" -czf "$DIR/package/matchora-${version}-linux-amd64.tar.gz" matchora
  rm -rf "$staging"
  echo "wrote $DIR/package/matchora-${version}-linux-amd64.tar.gz"
}

start() {
  if [[ ! -x "$DIR/dist/matchora" ]]; then
    echo "error: build/dist/matchora not found; pick a rebuild option" >&2
    exit 1
  fi
  exec "$DIR/dist/matchora" "$@"
}

# Arrow/enter menu. Sets CHOICE to the 0-based index.
menu() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "error: stdin/stdout must be a TTY" >&2
    exit 1
  fi
  local opts=("$@")
  local n=${#opts[@]}
  local i=0
  local key rest j
  printf '\e[?25l'
  restore() { printf '\e[?25h\e[0m'; }
  trap restore EXIT
  draw() {
    for j in "${!opts[@]}"; do
      if (( j == i )); then
        printf '\e[7m> %s\e[0m\n' "${opts[j]}"
      else
        printf '  %s\n' "${opts[j]}"
      fi
    done
  }
  draw
  while true; do
    IFS= read -rsn1 key
    rest=""
    if [[ $key == $'\e' ]]; then
      IFS= read -rsn2 -t 0.1 rest || rest=""
      key+="$rest"
    fi
    case "$key" in
      $'\e[A')
        i=$(( (i - 1 + n) % n ))
        ;;
      $'\e[B')
        i=$(( (i + 1) % n ))
        ;;
      "")
        printf '\e[%dA' "$n"
        for j in "${!opts[@]}"; do
          printf '\e[2K\n'
        done
        printf '\e[%dA' "$n"
        restore
        trap - EXIT
        CHOICE=$i
        return 0
        ;;
      *)
        continue
        ;;
    esac
    printf '\e[%dA' "$n"
    draw
  done
}

CHOICE=
menu "run" "(re)build & run" "(re)build & prepare" "(re)build & package"
case "$CHOICE" in
  0)
    start
    ;;
  1)
    rebuild
    start
    ;;
  2)
    rebuild
    start --prepare
    ;;
  3)
    rebuild
    package
    ;;
esac
