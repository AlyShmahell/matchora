#!/bin/sh
set -eu
URL="${MATCHORA_URL:-http://matchora:7680}"

i=0
while [ "$i" -lt 90 ]; do
  if curl -sf "$URL/health" | grep -q '"healthy"'; then
    break
  fi
  i=$((i + 1))
  sleep 1
done

body="$(curl -sf "$URL/health")"
echo "$body" | grep -q '"healthy":true'
echo "$body" | grep -q '"version"'

html="$(curl -sf "$URL/")"
echo "$html" | grep -qi "matchora"
echo "$html" | grep -qi "admin"
echo "$html" | grep -q "chip-total"
echo "$html" | grep -q "chip-success"
echo "$html" | grep -q "chip-manual"
echo "$html" | grep -q "chip-pending"
echo "$html" | grep -q "chip-failure"
echo "$html" | grep -q "chip-group"
echo "$html" | grep -q 'id="waits"'
echo "$html" | grep -q 'id="clear"'
echo "$html" | grep -q "<progress"
echo "$html" | grep -q 'id="secrets"'
echo "$html" | grep -q 'id="secret-fields"'

cfg="$(curl -sf "$URL/v1/config")"
echo "$cfg" | grep -q '^{}'

wait_healthy() {
  i=0
  while [ "$i" -lt 90 ]; do
    if curl -sf "$URL/health" | grep -q '"healthy"'; then
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  return 1
}

# POST secrets/config re-execs; do not treat a still-up old process as ready.
wait_after_restart() {
  i=0
  while [ "$i" -lt 20 ]; do
    if ! curl -sf "$URL/health" >/dev/null; then
      break
    fi
    i=$((i + 1))
    sleep 1
  done
  wait_healthy
}

got="$(curl -sf "$URL/v1/secrets")"
echo "$got" | grep -q '"omdb":false'
echo "$got" | grep -q '"tmdb":false'

# POST restarts the process; curl may drop after the 200. Wait for downtime then health.
curl -sS -o /dev/null -H 'Content-Type: application/json' \
  -d '{"omdb":"smoke-omdb"}' "$URL/v1/secrets" || true
wait_after_restart
got="$(curl -sf "$URL/v1/secrets")"
echo "$got" | grep -q '"omdb":true'
echo "$got" | grep -q '"tmdb":false'

curl -sS -o /dev/null -H 'Content-Type: application/json' \
  -d '{"omdb":""}' "$URL/v1/secrets" || true
wait_after_restart
got="$(curl -sf "$URL/v1/secrets")"
echo "$got" | grep -q '"omdb":false'

session_id() {
  printf '%s\n' "$1" | sed -n 's/.*"session":"\([^"]*\)".*/\1/p' | head -n 1
}

resp="$(curl -sS -w '\n%{http_code}' -F "file=@/fixtures/titles.csv;type=text/csv" "$URL/v1/ingest")"
code="$(printf '%s\n' "$resp" | tail -n 1)"
ingested="$(printf '%s\n' "$resp" | sed '$d')"
echo "$ingested" | grep -qv 'permission denied'
[ "$code" = "202" ]
echo "$ingested" | grep -q '"session"'
echo "$ingested" | grep -q '"jobs"'
echo "$ingested" | grep -q '"status":"pending"'
ingsess="$(session_id "$ingested")"
[ -n "$ingsess" ]

jobs=""
i=0
while [ "$i" -lt 40 ]; do
  jobs="$(curl -sf "$URL/v1/jobs?session=$ingsess")"
  if echo "$jobs" | grep -q '"status":"matched"' \
    && echo "$jobs" | grep -q '"ranker":"seq"' \
    && echo "$jobs" | grep -q '"provider":"tvmaze"' \
    && echo "$jobs" | grep -q '"provider":"jikan"' \
    && echo "$jobs" | grep -q '"catalog_for"' \
    && ! echo "$jobs" | grep -q '"status":"pending"'; then
    break
  fi
  i=$((i + 1))
  sleep 1
done
echo "$jobs" | grep -q '"status":"matched"'
echo "$jobs" | grep -q '"ranker":"seq"'
echo "$jobs" | grep -q '"provider":"tvmaze"'
echo "$jobs" | grep -q '"provider":"jikan"'
echo "$jobs" | grep -q '"catalog_for"'

catlist=""
i=0
while [ "$i" -lt 20 ]; do
  catlist="$(curl -sf "$URL/v1/catalog?session=$ingsess" || true)"
  if echo "$catlist" | grep -q '"provider":"tvmaze"' && echo "$catlist" | grep -q '"title":"Girls"'; then
    break
  fi
  i=$((i + 1))
  sleep 1
done
echo "$catlist" | grep -q '"provider":"tvmaze"'
echo "$catlist" | grep -q '"title":"Girls"'
one="$(curl -sf "$URL/v1/catalog/tvmaze/139?session=$ingsess")"
echo "$one" | grep -q '"title":"Girls"'
echo "$one" | grep -q '"seasons"'

scan="$(curl -sS -w '\n%{http_code}' -H 'Content-Type: application/json' \
  -d '{"path":"/opt/matchora/data/library"}' "$URL/v1/scan")"
scode="$(printf '%s\n' "$scan" | tail -n 1)"
sbody="$(printf '%s\n' "$scan" | sed '$d')"
[ "$scode" = "202" ]
echo "$sbody" | grep -q '"session"'
echo "$sbody" | grep -q '"files"'
echo "$sbody" | grep -qE '"files":\s*[1-9]'
scansess="$(session_id "$sbody")"
[ -n "$scansess" ]
[ "$scansess" != "$ingsess" ]
scanst="$(curl -sf "$URL/v1/scan/status?session=$scansess")"
echo "$scanst" | grep -q '"files"'
echo "$scanst" | grep -qE '"files":\s*[1-9]'

i=0
while [ "$i" -lt 40 ]; do
  jobs="$(curl -sf "$URL/v1/jobs?session=$scansess")"
  if echo "$jobs" | grep -q '"source":"scan"' \
    && echo "$jobs" | grep -q '"title":"Girls"' \
    && echo "$jobs" | grep -q '"title":"Cowboy Bebop"' \
    && echo "$jobs" | grep -q '"status":"matched"' \
    && echo "$jobs" | grep -q '"ranker":"seq"' \
    && ! echo "$jobs" | grep -q '"status":"pending"'; then
    break
  fi
  i=$((i + 1))
  sleep 1
done
echo "$jobs" | grep -q '"source":"scan"'
echo "$jobs" | grep -q '"title":"Girls"'
echo "$jobs" | grep -q '"title":"Cowboy Bebop"'
echo "$jobs" | grep -q '"ranker":"seq"'
echo "$jobs" | grep -q '"status":"matched"'
! echo "$jobs" | grep -q '"status":"pending"'

curl -sf -X POST "$URL/v1/match?session=$scansess" | grep -q '"status":"pending"'
i=0
while [ "$i" -lt 40 ]; do
  jobs="$(curl -sf "$URL/v1/jobs?session=$scansess")"
  if echo "$jobs" | grep -q '"status":"matched"' && ! echo "$jobs" | grep -q '"status":"pending"'; then
    break
  fi
  i=$((i + 1))
  sleep 1
done
echo "$jobs" | grep -q '"status":"matched"'

retry="$(curl -sf -X POST "$URL/v1/retry?session=$scansess")"
echo "$retry" | grep -q '^\['
jobs="$(curl -sf "$URL/v1/jobs?session=$scansess")"
echo "$jobs" | grep -q '"status":"matched"'
! echo "$jobs" | grep -q '"status":"pending"'

cleared="$(curl -sf -X DELETE "$URL/v1/jobs?session=$scansess")"
echo "$cleared" | grep -q '^\[\]'
! curl -sf "$URL/v1/jobs?session=$scansess"

echo "smoke ok"
